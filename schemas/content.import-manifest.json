{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pubphys.com/protocol/schemas/content.import-manifest.json",
  "title": "content.import-manifest",
  "description": "pubphys.content.import-manifest/1 (SPEC section 6).",
  "type": "object",
  "required": [
    "as_of",
    "counts",
    "items_file_id",
    "predicate",
    "source"
  ],
  "properties": {
    "source": {
      "type": "string"
    },
    "as_of": {
      "type": "string"
    },
    "predicate": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)$"
      }
    },
    "items_file_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,40}$"
    }
  },
  "additionalProperties": false
}
