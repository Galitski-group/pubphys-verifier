{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pubphys.com/protocol/schemas/content.platform-key-revocation.json",
  "title": "content.platform-key-revocation",
  "description": "pubphys.content.platform-key-revocation/1 (SPEC section 6).",
  "type": "object",
  "required": [
    "key_id",
    "reason"
  ],
  "properties": {
    "key_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reason": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
